
{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "src/test/features/**/*.feature"
    ],
    "publishQuiet": true,
    "dryRun": false,
    "timeout": 30000,
    "parallel": 2,
    "require": [
      "src/test/steps/**/*.ts",
      "src/test/hooks/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "progress-bar",
      "allure-cucumberjs/reporter"
    ]
  }
}
